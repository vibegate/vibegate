{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/typescript-config/base.json",
  "include": [
    "./src/**/*.ts",
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules"
  ],
  "compilerOptions": {
    "strict": true,
    "outDir": "./dist",
    "declaration": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022"
  }
}
